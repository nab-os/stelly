# Copy to .env beside the checkout. The real environment wins over any .env
# file, which is how compose passes these in without a mount.
#
# The music itself is the providers': services that answer the provider
# protocol (https://github.com/nab-os/stelly-provider) for a catalogue, and
# hold whatever account that catalogue needs.

# The providers, most preferred first; a token where one is wanted as the
# URL's user. Or STELLY_PROVIDER_URL for just one (default
# http://127.0.0.1:7710).
# STELLY_PROVIDERS=http://127.0.0.1:7710,http://127.0.0.1:7712

# The token the providers want, for those that name none of their own:
# required when they listen anywhere but loopback. compose.yaml hands it to
# each of them too.
# STELLY_PROVIDER_TOKEN=

# For compose.yaml: how devices reach the YouTube Music provider, which
# relays its audio itself.
# YTMUSIC_PUBLIC_URL=http://<this-host>:7712
