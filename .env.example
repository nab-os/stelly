# Copy to .env beside the checkout, or let `two-khz-server login` write it.
# Only the server reads these, and the real environment wins over any .env
# file, which is how compose passes them in without a mount.

# Required. `two-khz-server refresh-credentials --write` scrapes the current
# ones from the web player.
QOBUZ_APP_ID=

# One of these signs the stream URLs. QOBUZ_APP_SECRETS is a comma-separated
# list; the working one is found by trying them.
QOBUZ_APP_SECRET=
# QOBUZ_APP_SECRETS=

# Qobuz blocks programmatic user/login at their edge, so the token is the only
# way in. `two-khz-server login` gets one through the browser; or by hand:
#   1. Log in at https://play.qobuz.com/
#   2. devtools -> Application -> Local Storage -> play.qobuz.com
#   3. Copy the value of the `localuser.token` key
QOBUZ_USER_AUTH_TOKEN=

# Unused while the token above is set; kept for the login path.
# QOBUZ_EMAIL=
# QOBUZ_PASSWORD=
