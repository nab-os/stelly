# The build context is the repo root, but the image only needs app/, server/
# and schema.sql, everything below would either bloat it or leak into it.

.git
.github
docs
*.md

# Credentials. They come in as environment variables; see compose.yaml.
.env

# Host build output. Copying a host target/ in would also defeat the cache
# mount in the builder stage.
**/target
.direnv

# The corpus and the weights belong in a volume, not a layer.
data
cache

# Android leftovers; see the README.
app/gen
app/mobile.toml
app/android-env.sh
